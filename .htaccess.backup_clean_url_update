# --- BLUEHOST FIREWALL BYPASS ---
<IfModule mod_security.c>
  SecFilterEngine Off
  SecFilterScanPOST Off
</IfModule>
<IfModule mod_env.c>
  SetEnv NO_CACHE 1
</IfModule>
# --------------------------------

# 1. Force HTTPS
RewriteEngine On

# 301 Permanent Redirects for Clean URL updates


RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Set the Base to your folder
<IfModule mod_rewrite.c>

# Strip .html extension for clean URLs
RewriteCond %{THE_REQUEST} ^GET.*\.html [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,NC,L]

